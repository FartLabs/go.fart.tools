{
  "lock": false,
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@fartlabs/go"]
  },
  "imports": {
    "@fartlabs/go": "jsr:@fartlabs/go@0.0.5",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "fmt": {
    "lineWidth": 120,
    "newLineKind": "lf",
    "exclude": ["dist/"]
  },
  "lint": {
    "exclude": ["dist/"]
  },
  "tasks": {
    "build": "deno run --allow-read --allow-write build.ts",
    "test": "deno test --allow-read",
    "check": "deno fmt --check && deno lint && deno task test && deno task build"
  }
}
