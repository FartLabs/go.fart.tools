// Cloudflare Worker for the apex domain, fart.tools. It redirects to fartlabs.org.
//
// Deploy with: npx wrangler deploy -c apex/wrangler.jsonc
{
  "$schema": "https://unpkg.com/wrangler@4.112.0/config-schema.json",
  "name": "fart-tools-apex",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [{ "pattern": "fart.tools", "custom_domain": true }]
}
